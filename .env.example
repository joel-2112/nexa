# =============================================================================
# NEXA – Environment Configuration Reference
# Copy this file to .env and populate with your actual credentials.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION  (REQUIRED)
# -----------------------------------------------------------------------------
APP_ENV=development                        # development | staging | production
APP_NAME=NEXA
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-64-chars

# -----------------------------------------------------------------------------
# JWT  (REQUIRED)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-another-long-random-secret-key-for-jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# ENCRYPTION  (REQUIRED – for OAuth tokens at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=your-fernet-encryption-key-base64-encoded-here

# -----------------------------------------------------------------------------
# POSTGRESQL  (REQUIRED)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexa
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=nexa_password
# Full DSN is built automatically from the above; override here if needed:
# DATABASE_URL=postgresql+asyncpg://nexa_user:nexa_password@localhost:5432/nexa

# -----------------------------------------------------------------------------
# REDIS  (REQUIRED – for Celery broker & result backend)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL=redis://:password@localhost:6379/0

# -----------------------------------------------------------------------------
# CELERY  (optional overrides – defaults derived from Redis settings above)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# -----------------------------------------------------------------------------
# OPENAI  (REQUIRED for AI features)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=60

# -----------------------------------------------------------------------------
# GOOGLE OAUTH 2.0  (REQUIRED for Google Workspace integration)
# Create credentials at https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/tasks

# -----------------------------------------------------------------------------
# TELEGRAM BOT  (REQUIRED for Telegram integration)
# Create a bot via @BotFather
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/integrations/telegram/webhook

# -----------------------------------------------------------------------------
# N8N AUTOMATION  (REQUIRED for n8n workflow integration)
# -----------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret-here
# Workflow IDs – populate as you create workflows in n8n
N8N_WORKFLOW_CALENDAR_EVENT=
N8N_WORKFLOW_SEND_EMAIL=
N8N_WORKFLOW_SEND_REMINDER=

# -----------------------------------------------------------------------------
# CORS  (REQUIRED)
# Comma-separated list of allowed origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                            # json | console
LOG_FILE=                                  # Leave empty to log to stdout only

# -----------------------------------------------------------------------------
# TIMEZONE
# -----------------------------------------------------------------------------
DEFAULT_TIMEZONE=Africa/Addis_Ababa

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# =============================================================================
# NOTES
# =============================================================================
# REQUIRED to run the core application (no integrations):
#   APP_*, SECRET_KEY, JWT_*, ENCRYPTION_KEY, POSTGRES_*, REDIS_*, CELERY_*
#
# REQUIRED for AI features:
#   OPENAI_*
#
# REQUIRED for Google Workspace features:
#   GOOGLE_*
#
# REQUIRED for Telegram features:
#   TELEGRAM_*
#
# REQUIRED for n8n automation:
#   N8N_*
#
# Features are gracefully disabled when their credentials are absent.
# =============================================================================

